# ==============================================================================
# Leihbase / P2P-Leihbase Environment Configuration Template
# Copy this file to .env and adjust the values for your setup:
#   cp .env.example .env
# ==============================================================================

# --- Frontend (Nuxt Web App) ---
NUXT_PUBLIC_LOCALE=de
NUXT_PUBLIC_POCKETBASE_SERVER_BASE_URL=http://pocketbase:8090
NUXT_PUBLIC_POCKETBASE_CLIENT_BASE_URL=http://localhost:8090
NUXT_PUBLIC_PLAUSIBLE_TRACKING_DOMAIN=
NUXT_PUBLIC_CAP_INSTANCE_HOST=
NUXT_PUBLIC_CAP_SITE_KEY=

# --- Backend (PocketBase) ---
CONFIG_LOCALE=de
CONFIG_APP_NAME=Leihbase
CONFIG_APP_LOGO=
CONFIG_APP_URL=http://localhost:3000
CONFIG_RESERVATION_REQUIRE_USER=false
CONFIG_LENDING_CONDITIONS_LINK=https://example.com/lending-conditions

# --- Captcha Settings (Optional) ---
CONFIG_CAP_INSTANCE_HOST=
CONFIG_CAP_SITE_KEY=
CONFIG_CAP_SECRET_KEY=

# --- SMTP / Email Notifications ---
CONFIG_SMTP_ENABLED=false
CONFIG_SMTP_HOST=smtp.example.com
CONFIG_SMTP_PORT=587
CONFIG_SMTP_USERNAME=info@example.com
CONFIG_SMTP_PASSWORD=secret_smtp_password
CONFIG_SMTP_TLS=false
CONFIG_SMTP_AUTH_METHOD=LOGIN
CONFIG_SMTP_SENDER_ADDRESS=info@example.com
CONFIG_SMTP_SENDER_NAME=Leihbase

